# Copy to .env and adjust, or just export these before running.

# ---- This gateway ----
PMA_HOST=0.0.0.0
PMA_PORT=8080

# The name YOUR model answers to. Point clients at this.
PMA_MODEL_NAME=kimi-k2.5-local

# Optional: require this key from clients (Bearer token or x-api-key).
# Leave empty for an open, localhost-only gateway.
PMA_API_KEY=

# ---- Local backend that runs the actual weights ----
# Any OpenAI-compatible server. Defaults below target a local Ollama.
#   Ollama:      http://localhost:11434/v1     (key: ollama)
#   llama.cpp:   http://localhost:8080/v1      (llama-server --api)
#   vLLM/SGLang: http://localhost:8000/v1
#   LM Studio:   http://localhost:1234/v1
PMA_BACKEND_URL=http://localhost:11434/v1
PMA_BACKEND_KEY=ollama

# The real model tag the backend should load.
PMA_BACKEND_MODEL=llama3.1:8b

# If true, pass the client's requested model name straight through instead
# of forcing PMA_BACKEND_MODEL (useful if your backend hosts several models).
PMA_MODEL_PASSTHROUGH=false

# Upstream request timeout (seconds).
PMA_TIMEOUT=600
